# Copy to .env.local (development) or set in cPanel → Setup Node.js App → Environment variables (production).
# Without the Supabase values the site shows its built-in content and /admin shows setup steps.

# Supabase → Project Settings → API Keys: the publishable key (sb_publishable_…) and a secret key (sb_secret_…).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret: only used on the server, to add and remove admins from /admin/users. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Gemini: the admin panel translates the client's Indonesian into English and French on save.
# aistudio.google.com → Get API key. Free, no billing or card. See docs/admin.md.
GEMINI_API_KEY=
# Optional. Another Gemini model id if the default (gemini-3.5-flash-lite) is retired or leaves the free tier.
GEMINI_MODEL=

# Optional fallback, used when Gemini fails (or instead of it when GEMINI_API_KEY is empty). Needs billing on.
# Console → APIs & Services → Credentials → API key, restricted to "Cloud Translation API". See docs/admin.md.
GOOGLE_TRANSLATE_API_KEY=

# Optional. Live Google rating and reviews on the home page, from the business's Google Maps listing. See docs/admin.md.
# Without them the home page shows the rating from the business settings and the reviews typed in the admin panel.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Optional. Google Search Console → Add property → URL prefix → "HTML tag": paste only the content="…" value.
# Not needed if the domain is verified with a DNS record instead.
GOOGLE_SITE_VERIFICATION=
