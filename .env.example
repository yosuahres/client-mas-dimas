# Copy to .env.local (development) or set in cPanel → Setup Node.js App → Environment variables (production).
# Without the Supabase values the site shows its built-in content and /admin shows setup steps.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret: only used on the server, to add and remove admins from /admin/users. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 → the photos bucket. Create an API token with "Object Read & Write" for this bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=jogja-transport-photos
# Where the bucket is served publicly (a custom domain on the bucket), without a trailing slash.
R2_PUBLIC_URL=https://img.jogja-transport.com

# Google Cloud Translation: the admin panel translates the client's Indonesian into English and French on save.
# Console → APIs & Services → Credentials → API key, restricted to "Cloud Translation API". See docs/admin.md.
GOOGLE_TRANSLATE_API_KEY=

# Optional. Google Search Console → Add property → URL prefix → "HTML tag": paste only the content="…" value.
# Not needed if the domain is verified with a DNS record instead.
GOOGLE_SITE_VERIFICATION=
